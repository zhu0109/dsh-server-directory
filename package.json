{
  "name": "dsh-server-directory",
  "version": "0.1.1",
  "description": "Server directory browser for DeepSeek Harness: multi-server SFTP/FTP browsing and file management in the right sidebar.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhu0109/dsh-server-directory.git"
  },
  "homepage": "https://github.com/zhu0109/dsh-server-directory",
  "bugs": {
    "url": "https://github.com/zhu0109/dsh-server-directory/issues"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12.0",
    "dsh": "^0.2.1-rc.1"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsdown",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && tsdown",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1 <0.3.0-0",
    "dsh-better-sidebar": "^0.28.0",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/ssh2": "^1.15.5",
    "ftp-srv": "^4.6.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
